# BizDevX Accord — 環境変数テンプレート
# このファイルは Git 管理対象（値はコミットしない）
# コピー手順: cp .env.local.example .env.local → 値を記入 → source .env.local

# =============================================
# アプリケーション設定
# =============================================

# Node.js 実行環境（development / production / test）
NODE_ENV=development

# Next.js 開発サーバーポート（デフォルト 3000）
PORT=3000

# =============================================
# データベース設定
# =============================================

# SQLite DB ファイルパス（development 用）
DATABASE_URL=./data/bizdevx.db

# テスト用インメモリ DB（テスト時は :memory: を使用。通常は変更不要）
# DATABASE_URL=:memory:

# =============================================
# プロセステンプレート設定
# =============================================

# bizdevx 標準プロセス YAML の配置ディレクトリ
PROCESS_TEMPLATE_DIR=./templates

# =============================================
# Next.js 公開変数（NEXT_PUBLIC_ プレフィックス）
# =============================================

# アプリのベース URL（本番環境にデプロイ後に設定）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# アプリバージョン（package.json から取得するため通常は変更不要）
# NEXT_PUBLIC_APP_VERSION=0.1.0

# =============================================
# E2E テスト設定（Playwright 用）
# =============================================

# Playwright が接続するベース URL
PLAYWRIGHT_BASE_URL=http://localhost:3000

# E2E テスト用のシードユーザー情報（テスト環境のみ）
# E2E_TEST_USER_EMAIL=test@example.com
# E2E_TEST_USER_ROLE=facilitator
